<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArqSync — {{ project_name }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            color-scheme: light;
            --font-sans: "Inter", "Roboto", "Segoe UI", -apple-system, Helvetica, Arial, sans-serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

            /* neutrals */
            --bg: #f5f6f8;
            --surface: #ffffff;
            --surface-alt: #f0f2f5;
            --text: #1b2030;
            --text-muted: #5c6472;
            --border: #e1e4ea;

            /* dark blue - brand / informational cards */
            --navy: #16233f;
            --accent: #1d4ed8;
            --accent-bg: #eaf0fe;
            --accent-border: #c7d7fb;

            /* alerts only: red for violations, orange for cycles */
            --danger: #c11d3a;
            --danger-bg: #fcecef;
            --danger-border: #f4c2cd;

            --cycle: #c2410c;
            --cycle-bg: #fdf1e6;
            --cycle-border: #f6cda3;

            /* healthy / no-problem state */
            --success: #157a4d;
            --success-bg: #e8f6ef;
            --success-border: #b8e3cb;

            --radius: 10px;
            --shadow: 0 1px 2px rgba(20, 24, 33, 0.04), 0 6px 20px rgba(20, 24, 33, 0.05);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 2.5rem 1.5rem 4rem;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 15.5px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        main { max-width: 1000px; margin: 0 auto; }

        /* ---- Header ---- */
        header.hero { margin-bottom: 1.75rem; }
        .eyebrow {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-bg);
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            margin-bottom: 0.7rem;
        }
        h1 {
            margin: 0 0 0.35rem;
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            color: var(--navy);
        }
        h1 .project-name { color: var(--accent); }
        .subtitle { color: var(--text-muted); font-size: 0.92rem; margin: 0 0 0.9rem; }
        .subtitle code {
            background: var(--surface-alt);
            border: 1px solid var(--border);
            padding: 0.1rem 0.4rem;
            border-radius: 5px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            border: 1px solid transparent;
        }
        .status-badge.severity-critical { background: var(--danger-bg); color: var(--danger); border-color: var(--danger-border); }
        .status-badge.severity-warning { background: var(--cycle-bg); color: var(--cycle); border-color: var(--cycle-border); }
        .status-badge.severity-ok { background: var(--success-bg); color: var(--success); border-color: var(--success-border); }

        /* ---- Sections, generic ---- */
        section { margin-bottom: 2.25rem; }
        h2 {
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0 0 0.9rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        h3 {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin: 1.5rem 0 0.75rem;
        }
        .count-pill {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--surface-alt);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 0.05rem 0.55rem;
        }
        .section-intro { color: var(--text-muted); font-size: 0.92rem; margin: -0.4rem 0 1rem; }
        .empty-state {
            color: var(--success);
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            border-radius: var(--radius);
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* ---- Executive summary (only place icons appear) ---- */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 0.85rem;
        }
        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: var(--radius);
            padding: 0.95rem 1.1rem;
            box-shadow: var(--shadow);
        }
        .summary-card.tone-danger { border-left-color: var(--danger); }
        .summary-card.tone-cycle { border-left-color: var(--cycle); }
        .summary-card.tone-good { border-left-color: var(--success); }
        .summary-card .summary-icon { font-size: 1.1rem; margin-right: 0.4rem; }
        .summary-card .summary-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .summary-card .summary-value { font-size: 1.15rem; font-weight: 700; margin-top: 0.3rem; color: var(--text); }
        .summary-card .summary-detail { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem; }

        /* ---- Architecture style card (informational -> blue) ---- */
        .style-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: var(--radius);
            padding: 1.1rem 1.3rem;
            box-shadow: var(--shadow);
        }
        .style-card p { margin: 0; color: var(--text-muted); max-width: 70ch; font-size: 0.92rem; }

        /* ---- Diagram ---- */
        .diagram-wrapper {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.1rem;
            overflow-x: auto;
            box-shadow: var(--shadow);
        }

        /* ---- Cards: violations / cycles / suggestions ---- */
        .card-list { display: flex; flex-direction: column; gap: 0.85rem; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left-width: 4px;
            border-radius: var(--radius);
            padding: 1rem 1.15rem;
            box-shadow: var(--shadow);
        }
        .card.cycle { border-left-color: var(--cycle); }
        .card.violation { border-left-color: var(--danger); }
        .card.suggestion { border-left-color: var(--accent); }

        .card-path {
            font-family: var(--font-mono);
            font-size: 0.88rem;
            color: var(--text);
            margin: 0.3rem 0 0.7rem;
            word-break: break-word;
        }
        .badge {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
        }
        .badge.cycle { background: var(--cycle-bg); color: var(--cycle); border: 1px solid var(--cycle-border); }
        .badge.violation-skip { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
        .badge.violation-inversion { background: #f1e9fd; color: #7233c7; border: 1px solid #ddc4f7; }

        .card-explanation { margin: 0 0 0.6rem; color: var(--text); font-size: 0.92rem; }
        .card-suggestion {
            background: var(--surface-alt);
            border-radius: 8px;
            padding: 0.6rem 0.75rem;
            font-size: 0.88rem;
            color: var(--text-muted);
        }
        .card-suggestion .suggestion-label { color: var(--text); font-weight: 600; }

        /* ---- Suggestions section ---- */
        .suggestion-context {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0 0 0.3rem;
        }
        .suggestion-text { margin: 0; font-size: 0.92rem; color: var(--text); }

        /* ---- Tables ---- */
        table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        thead th {
            text-align: left;
            padding: 0.55rem 0.8rem;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid var(--border);
        }
        tbody td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover { background: var(--surface-alt); }
        table code { font-family: var(--font-mono); font-size: 0.85rem; }
        .table-wrapper {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }
        .metrics-table td.metric-value { font-weight: 700; text-align: right; width: 6rem; }
        .metrics-table tr.row-danger td.metric-value { color: var(--danger); }
        .metrics-table tr.row-cycle td.metric-value { color: var(--cycle); }

        footer {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 3rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
        }
        footer .footer-brand { font-weight: 700; color: var(--navy); margin: 0 0 0.35rem; }
        footer .footer-note { margin: 0; max-width: 80ch; }
        footer code { font-family: var(--font-mono); }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
</head>
<body>
<main>
    <header class="hero">
        <span class="eyebrow">Relatório de Arquitetura</span>
        <h1>ArqSync — <span class="project-name">{{ project_name }}</span></h1>
        <p class="subtitle">
            <code>{{ root_path }}</code><br>
            Gerado em {{ generated_at }}
        </p>
        <span class="status-badge severity-{{ status.severity }}">{{ status.headline }}</span>
    </header>

    <section id="summary">
        <h2>Resumo executivo</h2>
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">📊 Arquitetura detectada</div>
                <div class="summary-value">{{ architecture_style.name }}</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">📊 Tamanho do projeto</div>
                <div class="summary-value">{{ metrics_summary.total_classes }} classes</div>
                <div class="summary-detail">em {{ metrics_summary.total_packages }} pacotes</div>
            </div>
            <div class="summary-card {{ 'tone-danger' if metrics_summary.violation_count else 'tone-good' }}">
                <div class="summary-label">{{ '🔴' if metrics_summary.violation_count else '✅' }} Violações de camada</div>
                <div class="summary-value">{{ metrics_summary.violation_count }}</div>
            </div>
            <div class="summary-card {{ 'tone-cycle' if metrics_summary.cycle_count else 'tone-good' }}">
                <div class="summary-label">{{ '🟠' if metrics_summary.cycle_count else '✅' }} Ciclos de dependência</div>
                <div class="summary-value">{{ metrics_summary.cycle_count }}</div>
            </div>
        </div>
    </section>

    <section id="architecture-style">
        <h2>Arquitetura detectada: {{ architecture_style.name }}</h2>
        <div class="style-card">
            <p>{{ architecture_style.description }}</p>
        </div>
    </section>

    <section id="metrics">
        <h2>Métricas</h2>
        <div class="table-wrapper">
            <table class="metrics-table">
                <tbody>
                    <tr>
                        <td>Pacotes analisados</td>
                        <td class="metric-value">{{ metrics_summary.total_packages }}</td>
                    </tr>
                    <tr>
                        <td>Classes analisadas</td>
                        <td class="metric-value">{{ metrics_summary.total_classes }}</td>
                    </tr>
                    <tr>
                        <td>Dependências internas entre pacotes</td>
                        <td class="metric-value">{{ metrics_summary.total_dependencies }}</td>
                    </tr>
                    <tr class="{{ 'row-cycle' if metrics_summary.cycle_count }}">
                        <td>Ciclos de dependência detectados</td>
                        <td class="metric-value">{{ metrics_summary.cycle_count }}</td>
                    </tr>
                    <tr class="{{ 'row-danger' if metrics_summary.violation_count }}">
                        <td>Violações de camada detectadas</td>
                        <td class="metric-value">{{ metrics_summary.violation_count }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        {% if dependency_counts %}
        <h3>Dependências por pacote</h3>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Pacote</th>
                        <th>Dependências recebidas</th>
                        <th>Dependências enviadas</th>
                    </tr>
                </thead>
                <tbody>
                    {% for count in dependency_counts %}
                    <tr>
                        <td><code>{{ count.package }}</code></td>
                        <td>{{ count.incoming }}</td>
                        <td>{{ count.outgoing }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </section>

    <section id="diagram">
        <h2>Diagrama de dependências</h2>
        <p class="section-intro">
            Este diagrama mostra as dependências entre pacotes do projeto. Ciclos e violações de
            camada (detalhados abaixo) são as observações mais relevantes a procurar aqui.
        </p>
        <div class="diagram-wrapper">
            <pre class="mermaid">{{ mermaid_diagram }}</pre>
        </div>
    </section>

    <section id="violations">
        <h2>Violações de camada <span class="count-pill">{{ violations | length }}</span></h2>
        {% if violations %}
        <p class="section-intro">
            Uma violação de camada acontece quando um pacote depende de outro fora da ordem
            esperada (<code>controller → service → repository → domain</code>) — pulando uma
            camada intermediária, ou invertendo o sentido da dependência.
        </p>
        <div class="card-list">
            {% for violation in violations %}
            <div class="card violation">
                <span class="badge {{ 'violation-skip' if violation.type == 'LAYER_SKIP' else 'violation-inversion' }}">
                    {{ 'Camada pulada' if violation.type == 'LAYER_SKIP' else 'Inversão de camada' }}
                </span>
                <div class="card-path">{{ violation.from }} ({{ violation.from_layer | lower }}) → {{ violation.to }} ({{ violation.to_layer | lower }})</div>
                <p class="card-explanation">{{ violation.explanation }}</p>
                <p class="card-suggestion"><span class="suggestion-label">Sugestão de correção:</span> {{ violation.suggestion }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhuma violação de camada detectada.</p>
        {% endif %}
    </section>

    <section id="cycles">
        <h2>Ciclos de dependência <span class="count-pill">{{ cycles | length }}</span></h2>
        {% if cycles %}
        <p class="section-intro">
            Um ciclo de dependência significa que dois ou mais pacotes dependem uns dos outros,
            direta ou indiretamente — isso dificulta entender, testar e evoluir esses pacotes de
            forma isolada.
        </p>
        <div class="card-list">
            {% for cycle in cycles %}
            <div class="card cycle">
                <span class="badge cycle">Ciclo de {{ cycle.length }} pacote{{ 's' if cycle.length != 1 else '' }}</span>
                <div class="card-path">{{ cycle.path }}</div>
                <p class="card-explanation">{{ cycle.explanation }}</p>
                <p class="card-suggestion"><span class="suggestion-label">Sugestão de correção:</span> {{ cycle.suggestion }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhum ciclo de dependência detectado.</p>
        {% endif %}
    </section>

    <section id="suggestions">
        <h2>Sugestões de melhoria <span class="count-pill">{{ suggestions | length }}</span></h2>
        {% if suggestions %}
        <p class="section-intro">
            Ações práticas para resolver cada violação e ciclo listados acima, em ordem de
            aparição.
        </p>
        <div class="card-list">
            {% for item in suggestions %}
            <div class="card suggestion">
                <span class="badge {{ 'violation-skip' if item.kind == 'violation' else 'cycle' }}">
                    {{ 'Violação de camada' if item.kind == 'violation' else 'Ciclo de dependência' }}
                </span>
                <p class="suggestion-context">{{ item.context }}</p>
                <p class="suggestion-text">{{ item.text }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhuma ação necessária — nenhuma violação ou ciclo foi detectado.</p>
        {% endif %}
    </section>

    <footer>
        <p class="footer-brand">Gerado por ArqSync v1.2.0</p>
        <p class="footer-note">
            A detecção de ciclos independe de convenção de nomenclatura; a detecção de violações
            de camada e de estilo arquitetural depende dos pacotes seguirem convenções de
            nomenclatura reconhecidas (ex.: <code>controller</code>/<code>service</code>/<code>repository</code>/<code>domain</code>) —
            trate como um indício, não uma verdade absoluta.
        </p>
    </footer>
</main>
<script>
    mermaid.initialize({ startOnLoad: true, theme: "neutral" });
</script>
</body>
</html>
