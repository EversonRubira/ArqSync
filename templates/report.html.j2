<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArqSync — {{ project_name }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            color-scheme: light;
            --font-sans: "Inter", "Roboto", "Segoe UI", -apple-system, Helvetica, Arial, sans-serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

            /* neutrals */
            --bg: #f5f6f8;
            --surface: #ffffff;
            --surface-alt: #f0f2f5;
            --text: #1b2030;
            --text-muted: #5c6472;
            --border: #e1e4ea;

            /* dark blue - brand / informational cards */
            --navy: #16233f;
            --accent: #1d4ed8;
            --accent-dark: #1638b3;
            --accent-bg: #eaf0fe;
            --accent-border: #c7d7fb;

            /* alerts only: red for violations, orange for cycles */
            --danger: #c11d3a;
            --danger-bg: #fcecef;
            --danger-border: #f4c2cd;

            --cycle: #c2410c;
            --cycle-bg: #fdf1e6;
            --cycle-border: #f6cda3;

            /* healthy / no-problem state */
            --success: #157a4d;
            --success-bg: #e8f6ef;
            --success-border: #b8e3cb;

            --radius: 10px;
            --shadow: 0 1px 2px rgba(20, 24, 33, 0.04), 0 6px 20px rgba(20, 24, 33, 0.05);
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            padding: 2.5rem 1.5rem 4rem;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 15.5px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        main { max-width: 1000px; margin: 0 auto; }
        section { scroll-margin-top: 1.5rem; }

        /* ---- Table of contents ---- */
        .toc {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 1.75rem;
        }
        .toc a {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--navy);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 0.3rem 0.85rem;
            text-decoration: none;
        }
        .toc a:hover { background: var(--surface-alt); }

        /* ---- Header ---- */
        header.hero { margin-bottom: 1.75rem; }
        .hero-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .pdf-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-sans);
            font-size: 0.88rem;
            font-weight: 700;
            color: #fff;
            background: var(--accent);
            border: none;
            border-radius: 8px;
            padding: 0.6rem 1.1rem;
            cursor: pointer;
            box-shadow: var(--shadow);
            white-space: nowrap;
            flex: none;
        }
        .pdf-btn:hover { background: var(--accent-dark); }
        .pdf-btn-icon { flex: none; }
        .eyebrow {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-bg);
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            margin-bottom: 0.7rem;
        }
        h1 {
            margin: 0 0 0.35rem;
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            color: var(--navy);
        }
        h1 .project-name { color: var(--accent); }
        .subtitle { color: var(--text-muted); font-size: 0.92rem; margin: 0 0 0.9rem; }
        .subtitle code {
            background: var(--surface-alt);
            border: 1px solid var(--border);
            padding: 0.1rem 0.4rem;
            border-radius: 5px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            border: 1px solid transparent;
        }
        .status-badge.severity-critical { background: var(--danger-bg); color: var(--danger); border-color: var(--danger-border); }
        .status-badge.severity-warning { background: var(--cycle-bg); color: var(--cycle); border-color: var(--cycle-border); }
        .status-badge.severity-ok { background: var(--success-bg); color: var(--success); border-color: var(--success-border); }

        /* ---- Sections, generic ---- */
        section { margin-bottom: 2.25rem; }
        h2 {
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0 0 0.9rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        h3 {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin: 1.5rem 0 0.75rem;
        }
        .count-pill {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--surface-alt);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 0.05rem 0.55rem;
        }
        .section-intro { color: var(--text-muted); font-size: 0.92rem; margin: -0.4rem 0 1rem; }
        .empty-state {
            color: var(--success);
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            border-radius: var(--radius);
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* ---- Executive summary (only place icons appear) ---- */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 0.85rem;
        }
        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: var(--radius);
            padding: 0.95rem 1.1rem;
            box-shadow: var(--shadow);
        }
        .summary-card.tone-danger { border-left-color: var(--danger); }
        .summary-card.tone-cycle { border-left-color: var(--cycle); }
        .summary-card.tone-good { border-left-color: var(--success); }
        .summary-card .summary-icon { font-size: 1.1rem; margin-right: 0.4rem; }
        .summary-card .summary-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .summary-card .summary-value { font-size: 1.15rem; font-weight: 700; margin-top: 0.3rem; color: var(--text); }
        .summary-card .summary-detail { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem; }
        .hotspot-line {
            margin: 0.85rem 0 0;
            font-size: 0.88rem;
            color: var(--text-muted);
        }
        .hotspot-line strong { color: var(--text); }

        /* ---- Architecture style card (informational -> blue) ---- */
        .style-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: var(--radius);
            padding: 1.1rem 1.3rem;
            box-shadow: var(--shadow);
        }
        .style-card p { margin: 0; color: var(--text-muted); max-width: 70ch; font-size: 0.92rem; }

        /* ---- Diagram ---- */
        .diagram-toolbar {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.6rem;
            flex-wrap: wrap;
        }
        .diagram-btn {
            font-family: var(--font-sans);
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--navy);
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 0.3rem 0.75rem;
            cursor: pointer;
            line-height: 1;
        }
        .diagram-btn:hover { background: var(--surface-alt); }
        .diagram-btn-expand { color: var(--accent); border-color: var(--accent-border); background: var(--accent-bg); }
        .diagram-zoom-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            min-width: 3ch;
            text-align: center;
        }

        /* Single diagram instance: the wrapper is repositioned via the
           .is-fullscreen class rather than duplicated into a separate modal -
           see the HTML comment above the diagram markup for why. */
        .diagram-wrapper {
            position: relative;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.1rem;
            max-width: 100%;
            overflow: auto;
            box-shadow: var(--shadow);
        }
        .diagram-wrapper.diagram-thumbnail { max-height: 280px; }
        .diagram-zoom-target { transform-origin: top left; transition: transform 0.15s ease; }
        .diagram-expand-overlay {
            position: absolute;
            bottom: 0.9rem;
            right: 0.9rem;
            font-family: var(--font-sans);
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--surface);
            background: rgba(22, 35, 63, 0.85);
            border: none;
            border-radius: 999px;
            padding: 0.45rem 0.95rem;
            cursor: pointer;
        }

        .diagram-wrapper.is-fullscreen {
            position: fixed;
            inset: 1.25rem;
            z-index: 1000;
            max-height: none;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        }
        .diagram-wrapper.is-fullscreen .diagram-expand-overlay { display: none; }
        .diagram-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 999;
            background: rgba(20, 24, 33, 0.85);
        }
        .diagram-backdrop.is-visible { display: block; }

        .diagram-legend {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem 1.25rem;
            margin-top: 0.75rem;
            font-size: 0.82rem;
            color: var(--text-muted);
        }
        .diagram-legend .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }
        .diagram-legend .legend-swatch {
            display: inline-block;
            width: 1.4rem;
            height: 3px;
            border-radius: 2px;
            background: var(--border);
        }
        .diagram-legend .legend-swatch.cycle-edge { background: var(--danger); }

        /* Print/PDF-only Graphviz diagram (build_pdf_diagram_svg) - hidden on
           screen (where Mermaid, above, is the interactive one); shown only
           in @media print, see below. */
        .pdf-diagram-only { display: none; }

        /* ---- Cards: violations / cycles / suggestions ---- */
        .card-list { display: flex; flex-direction: column; gap: 0.85rem; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left-width: 4px;
            border-radius: var(--radius);
            padding: 1rem 1.15rem;
            box-shadow: var(--shadow);
        }
        .card.cycle { border-left-color: var(--cycle); }
        .card.violation { border-left-color: var(--danger); }
        .card.suggestion { border-left-color: var(--accent); }

        .card-path {
            font-family: var(--font-mono);
            font-size: 0.88rem;
            color: var(--text);
            margin: 0.3rem 0 0.7rem;
            word-break: break-word;
        }
        .badge {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
        }
        .badge.cycle { background: var(--cycle-bg); color: var(--cycle); border: 1px solid var(--cycle-border); }
        .badge.violation-skip { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
        .badge.violation-inversion { background: #f1e9fd; color: #7233c7; border: 1px solid #ddc4f7; }
        .badge.style-migration { background: var(--accent-bg); color: var(--accent-dark); border: 1px solid var(--accent-border); }
        .badge.general { background: var(--surface-alt); color: var(--text-muted); border: 1px solid var(--border); }

        .card-explanation { margin: 0 0 0.6rem; color: var(--text); font-size: 0.92rem; }
        .card-suggestion {
            background: var(--surface-alt);
            border-radius: 8px;
            padding: 0.6rem 0.75rem;
            font-size: 0.88rem;
            color: var(--text-muted);
        }
        .card-suggestion .suggestion-label { color: var(--text); font-weight: 600; }

        /* ---- AI suggestions section (--suggest, Groq) ---- */
        .card.ai-suggestion { border-left-color: var(--accent); }
        .ai-suggestion-title { margin: 0.4rem 0 0.5rem; font-size: 1rem; font-weight: 700; color: var(--text); }
        .ai-suggestion-description { margin: 0 0 0.6rem; color: var(--text); font-size: 0.92rem; }
        .ai-suggestion-code {
            background: var(--navy);
            color: #e6ecff;
            border-radius: 8px;
            padding: 0.75rem 0.9rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            overflow-x: auto;
            white-space: pre;
            margin: 0;
        }

        /* ---- Suggestions section ---- */
        .suggestion-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .suggestion-priority { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); }
        .suggestion-impact {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--accent);
            background: var(--accent-bg);
            border: 1px solid var(--accent-border);
            border-radius: 999px;
            padding: 0.1rem 0.55rem;
        }
        .suggestion-context {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0.5rem 0 0.3rem;
        }
        .suggestion-text { margin: 0; font-size: 0.92rem; color: var(--text); }
        .suggestion-impact-line { margin: 0.6rem 0 0; }

        /* ---- Tables ---- */
        table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        thead th {
            text-align: left;
            padding: 0.55rem 0.8rem;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid var(--border);
        }
        tbody td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover { background: var(--surface-alt); }
        table code { font-family: var(--font-mono); font-size: 0.85rem; }
        .table-wrapper {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }
        .metrics-table td.metric-value { font-weight: 700; text-align: right; width: 6rem; }
        .metrics-table tr.row-danger td.metric-value { color: var(--danger); }
        .metrics-table tr.row-cycle td.metric-value { color: var(--cycle); }

        footer {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 3rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
        }
        footer .footer-brand { font-weight: 700; color: var(--navy); margin: 0 0 0.35rem; }
        footer .footer-note { margin: 0; max-width: 80ch; }
        footer code { font-family: var(--font-mono); }

        /* ---- Print / PDF ----
           Triggered by the "Gerar PDF" button (window.print()). Interactive-
           only controls (nav, zoom, expand) are hidden, the base font size
           is bumped for legibility on paper (html uses pt so every rem-sized
           element scales with it), and the page prints landscape at A4 with
           generous margins.

           Mermaid vs. the print diagram: Mermaid (client-side, full graph)
           is hidden here - #diagram .diagram-wrapper/.diagram-legend below -
           and replaced by a *different*, purpose-built diagram
           (pdf_diagram_svg, build_pdf_diagram_svg in generate-report.py):
           server-rendered via Graphviz, scoped down to only the packages
           involved in a cycle or violation. That's what actually prints -
           small and legible no matter how large the full project graph is,
           which the full Mermaid graph (however scaled) isn't guaranteed to
           be once forced onto a fixed page size.

           The .mermaid-container/.diagram-zoom-target rules below (scale,
           transform-origin, svg sizing) are NOT removed even though Mermaid
           is hidden in the normal case - kept as a second, independent
           safety net: if display:none ever fails to apply (a future edit
           re-enables the Mermaid block, a browser quirk, etc.), the diagram
           still can't overflow the page or carry over the on-screen zoom
           level (see the beforeprint/afterprint reset in the zoom IIFE too -
           same belt-and-suspenders reasoning, covers Ctrl+P/browser-menu
           printing as well as the "Gerar PDF" button).

           #diagram gets page-break-before:always: the diagram section is
           placed last in the document (right before the footer) so whichever
           diagram ends up visible in print has a page entirely to itself -
           nothing else's text to overlap. */
        @media print {
            @page { size: A4 landscape; margin: 1.5cm; }
            .toc, .pdf-btn, .diagram-toolbar, .diagram-expand-overlay, .diagram-backdrop { display: none !important; }
            html { font-size: 12pt; }
            body { font-size: 11pt; padding: 0; }
            #diagram { page-break-before: always; }
            #diagram .section-intro { display: none !important; }
            .diagram-wrapper, .diagram-legend { display: none !important; }
            .pdf-diagram-only { display: block; }
            .pdf-diagram-svg { text-align: center; }
            .pdf-diagram-svg svg { max-width: 100% !important; height: auto !important; }
            .pdf-diagram-legend, .pdf-diagram-fallback {
                font-size: 0.85rem;
                font-style: italic;
                color: var(--text-muted);
                margin-top: 0.75rem;
            }
            /* Safety net only - see comment above; Mermaid is hidden above in
               the normal case, so these rules are not expected to apply. */
            .mermaid-container {
                page-break-inside: avoid;
                overflow: visible !important;
                transform: scale(0.75) !important;
                transform-origin: top left !important;
                width: 100% !important;
            }
            .mermaid-container svg,
            .diagram-zoom-target svg { max-width: 100% !important; height: auto !important; }
            .card, .style-card, .summary-card, .table-wrapper { box-shadow: none; }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
</head>
<body>
<main>
    <header class="hero">
        <div class="hero-top">
            <div class="hero-text">
                <span class="eyebrow">Relatório de Arquitetura</span>
                <h1>ArqSync — <span class="project-name">{{ project_name }}</span></h1>
                <p class="subtitle">
                    <code>{{ root_path }}</code><br>
                    Gerado em {{ generated_at }}
                </p>
                <span class="status-badge severity-{{ status.severity }}">{{ status.headline }}</span>
            </div>
            <button type="button" class="pdf-btn" id="generate-pdf-btn">
                <svg class="pdf-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                Gerar PDF
            </button>
        </div>
    </header>

    <nav class="toc" aria-label="Navegação do relatório">
        <a href="#summary">Resumo</a>
        <a href="#metrics">Métricas</a>
        <a href="#violations">Violações</a>
        <a href="#cycles">Ciclos</a>
        <a href="#suggestions">Sugestões</a>
        {% if ai_suggestions %}<a href="#ai-suggestions">Sugestões de IA</a>{% endif %}
        <a href="#diagram">Diagrama</a>
    </nav>

    <section id="summary">
        <h2>Resumo executivo</h2>
        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-label">📊 Arquitetura detectada</div>
                <div class="summary-value">{{ architecture_style.name }}</div>
            </div>
            <div class="summary-card">
                <div class="summary-label">📊 Tamanho do projeto</div>
                <div class="summary-value">{{ metrics_summary.total_classes }} classes</div>
                <div class="summary-detail">em {{ metrics_summary.total_packages }} pacotes</div>
            </div>
            <div class="summary-card {{ 'tone-danger' if metrics_summary.violation_count else 'tone-good' }}">
                <div class="summary-label">{{ '🔴' if metrics_summary.violation_count else '✅' }} Violações de camada</div>
                <div class="summary-value">{{ metrics_summary.violation_count }}</div>
            </div>
            <div class="summary-card {{ 'tone-cycle' if metrics_summary.cycle_count else 'tone-good' }}">
                <div class="summary-label">{{ '🟠' if metrics_summary.cycle_count else '✅' }} Ciclos de dependência</div>
                <div class="summary-value">{{ metrics_summary.cycle_count }}</div>
            </div>
        </div>
        {% if hotspots %}
        <p class="hotspot-line">
            📊 Concentrados principalmente em:
            {% for hotspot in hotspots %}<strong>{{ hotspot.module }}</strong> ({{ hotspot.count }}){{ ", " if not loop.last else "" }}{% endfor %}
        </p>
        {% endif %}
    </section>

    <section id="architecture-style">
        <h2>Arquitetura detectada: {{ architecture_style.name }}</h2>
        <div class="style-card">
            <p>{{ architecture_style.description }}</p>
        </div>
    </section>

    <section id="metrics">
        <h2>Métricas</h2>
        <div class="table-wrapper">
            <table class="metrics-table">
                <tbody>
                    <tr>
                        <td>Pacotes analisados</td>
                        <td class="metric-value">{{ metrics_summary.total_packages }}</td>
                    </tr>
                    <tr>
                        <td>Classes analisadas</td>
                        <td class="metric-value">{{ metrics_summary.total_classes }}</td>
                    </tr>
                    <tr>
                        <td>Dependências internas entre pacotes</td>
                        <td class="metric-value">{{ metrics_summary.total_dependencies }}</td>
                    </tr>
                    <tr class="{{ 'row-cycle' if metrics_summary.cycle_count }}">
                        <td>Ciclos de dependência detectados</td>
                        <td class="metric-value">{{ metrics_summary.cycle_count }}</td>
                    </tr>
                    <tr class="{{ 'row-danger' if metrics_summary.violation_count }}">
                        <td>Violações de camada detectadas</td>
                        <td class="metric-value">{{ metrics_summary.violation_count }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        {% if dependency_counts %}
        <h3>Dependências por pacote</h3>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Pacote</th>
                        <th>Dependências recebidas</th>
                        <th>Dependências enviadas</th>
                    </tr>
                </thead>
                <tbody>
                    {% for count in dependency_counts %}
                    <tr>
                        <td><code>{{ count.package }}</code></td>
                        <td>{{ count.incoming }}</td>
                        <td>{{ count.outgoing }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </section>

    <section id="violations">
        <h2>Violações <span class="count-pill">{{ violations | length }}</span></h2>
        {% if violations %}
        <p class="section-intro">
            Uma violação de camada acontece quando um pacote depende de outro fora da ordem
            esperada (<code>controller → service → repository → domain</code>) — pulando uma
            camada intermediária, ou invertendo o sentido da dependência. Em projetos de
            Arquitetura Hexagonal, um adapter sem porta é uma classe de adapter que não
            implementa nenhuma interface do núcleo do domínio.
        </p>
        <div class="card-list">
            {% for violation in violations %}
            {% if violation.kind == 'adapter_port' %}
            <div class="card violation">
                <span class="badge violation-skip">Adapter sem porta</span>
                <div class="card-path">{{ violation.package }}.{{ violation.class_name }}</div>
                <p class="card-explanation">
                    Esta classe está em um pacote classificado como adapter (Arquitetura
                    Hexagonal), mas não implementa nenhuma interface (porta) declarada em um
                    pacote do núcleo do domínio.
                </p>
                <p class="card-suggestion">
                    <span class="suggestion-label">Sugestão de correção:</span> Defina uma
                    interface no pacote do núcleo (ex.: <code>port</code>/<code>ports</code>)
                    representando o contrato que este adapter deveria implementar, e faça esta
                    classe implementá-la — mantendo o núcleo independente de detalhes de
                    infraestrutura.
                </p>
            </div>
            {% else %}
            <div class="card violation">
                <span class="badge {{ 'violation-skip' if violation.type == 'LAYER_SKIP' else 'violation-inversion' }}">
                    {{ 'Camada pulada' if violation.type == 'LAYER_SKIP' else 'Inversão de camada' }}
                </span>
                <div class="card-path">{{ violation.from }} ({{ violation.from_layer | lower }}) → {{ violation.to }} ({{ violation.to_layer | lower }})</div>
                <p class="card-explanation">{{ violation.explanation }}</p>
                <p class="card-suggestion"><span class="suggestion-label">Sugestão de correção:</span> {{ violation.suggestion }}</p>
            </div>
            {% endif %}
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhuma violação detectada.</p>
        {% endif %}
    </section>

    <section id="cycles">
        <h2>Ciclos de dependência <span class="count-pill">{{ cycles | length }}</span></h2>
        {% if cycle_groups %}
        <p class="section-intro">
            Um ciclo de dependência significa que dois ou mais pacotes dependem uns dos outros,
            direta ou indiretamente — isso dificulta entender, testar e evoluir esses pacotes de
            forma isolada. Agrupados por módulo para facilitar a leitura em projetos com muitos ciclos.
        </p>
        {% for group in cycle_groups %}
        <h3>{{ group.label }}</h3>
        <div class="card-list">
            {% for cycle in group.cycles %}
            <div class="card cycle">
                <span class="badge cycle">Ciclo de {{ cycle.length }} pacote{{ 's' if cycle.length != 1 else '' }}</span>
                <div class="card-path">{{ cycle.path }}</div>
                <p class="card-explanation">{{ cycle.explanation }}</p>
                <p class="card-suggestion"><span class="suggestion-label">Sugestão de correção:</span> {{ cycle.suggestion }}</p>
            </div>
            {% endfor %}
        </div>
        {% endfor %}
        {% else %}
        <p class="empty-state">Nenhum ciclo de dependência detectado.</p>
        {% endif %}
    </section>

    <section id="suggestions">
        <h2>Sugestões de melhoria <span class="count-pill">{{ suggestions | length }}</span></h2>
        {% if suggestions %}
        <p class="section-intro">
            Ações práticas para resolver cada violação e ciclo, priorizadas pelo impacto
            estimado — corrija primeiro as de maior prioridade.
        </p>
        <div class="card-list">
            {% for item in suggestions %}
            <div class="card suggestion">
                <div class="suggestion-header">
                    <span class="badge {{ 'violation-skip' if item.kind == 'violation' else 'cycle' }}">
                        {{ 'Violação de camada' if item.kind == 'violation' else 'Ciclo de dependência' }}
                    </span>
                    <span class="suggestion-priority">Prioridade #{{ loop.index }}</span>
                </div>
                <p class="suggestion-context">{{ item.context }}</p>
                <p class="suggestion-text">{{ item.text }}</p>
                {% if item.impact_label %}
                <p class="suggestion-impact-line"><span class="suggestion-impact">Impacto: {{ item.impact_label }}</span></p>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhuma ação necessária — nenhuma violação ou ciclo foi detectado.</p>
        {% endif %}
    </section>

    {% if ai_suggestions %}
    <section id="ai-suggestions">
        <h2>Sugestões de IA (Groq) <span class="count-pill">{{ ai_suggestions | length }}</span></h2>
        <p class="section-intro">
            Sugestões geradas por IA a partir de um resumo estruturado desta análise (métricas,
            ciclos, violações e estilo arquitetural — nenhum código-fonte foi enviado). São apenas
            recomendações para avaliação humana: o ArqSync nunca aplica refatorações
            automaticamente. Priorizadas por impacto: quebra de ciclos primeiro, depois violações
            de camada, depois estilo arquitetural.
        </p>
        <div class="card-list">
            {% for item in ai_suggestions %}
            <div class="card ai-suggestion">
                <span class="badge {{ {'CYCLE_BREAK': 'cycle', 'LAYER_VIOLATION': 'violation-skip', 'STYLE_MIGRATION': 'style-migration'}.get(item.type, 'general') }}">
                    {{ {'CYCLE_BREAK': 'Quebra de ciclo', 'LAYER_VIOLATION': 'Violação de camada', 'STYLE_MIGRATION': 'Migração de estilo'}.get(item.type, 'Geral') }}
                </span>
                <p class="ai-suggestion-title">{{ item.title }}</p>
                <p class="ai-suggestion-description">{{ item.description }}</p>
                {% if item.codeExample %}
                <pre class="ai-suggestion-code"><code>{{ item.codeExample }}</code></pre>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <section id="diagram">
        <h2>Diagrama de dependências</h2>
        <p class="section-intro">
            Este diagrama mostra as dependências entre pacotes do projeto. Ciclos e violações de
            camada (detalhados acima) são as observações mais relevantes a procurar aqui. Use os
            controles de zoom ou clique para expandir em tela cheia — útil em projetos com muitos
            pacotes.
        </p>

        <!--
            A single diagram instance, always visible in normal flow (never
            display:none) - "expand" just toggles a CSS class that repositions
            this same wrapper to fill the viewport (position: fixed). Mermaid
            only ever renders this one <pre class="mermaid"> once, on page
            load, while it's visible - rendering it a second time into a
            hidden/duplicate container (the previous approach) produces a
            zero-size, invisible SVG, which is why the expanded view used to
            look empty.

            Placed last, right before the footer: on screen this is just
            reading order, but in print it means the diagram is the only
            thing on its own page (page-break-before below) - since nothing
            else shares that page, there's no text left for its scaled-down
            SVG to overlap.
        -->
        <div class="diagram-wrapper diagram-thumbnail" id="diagram-wrapper">
            <div class="diagram-toolbar" data-diagram-toolbar data-initial-zoom="0.75">
                <button type="button" class="diagram-btn" data-action="zoom-out" aria-label="Reduzir zoom">−</button>
                <span class="diagram-zoom-label" data-zoom-label>75%</span>
                <button type="button" class="diagram-btn" data-action="zoom-in" aria-label="Aumentar zoom">+</button>
                <button type="button" class="diagram-btn" data-action="zoom-reset">Redefinir</button>
                <button type="button" class="diagram-btn" data-export-png>⬇ Exportar PNG</button>
                <button type="button" class="diagram-btn diagram-btn-expand" data-toggle-diagram>⤢ Expandir diagrama</button>
            </div>
            <div class="diagram-zoom-target mermaid-container" data-zoom-target>
                <pre class="mermaid">{{ mermaid_diagram }}</pre>
            </div>
            <button type="button" class="diagram-expand-overlay" data-toggle-diagram>🔍 Clique para expandir</button>
        </div>
        <div class="diagram-backdrop" data-diagram-backdrop></div>

        {% if cycles %}
        <div class="diagram-legend">
            <span class="legend-item"><span class="legend-swatch cycle-edge"></span> Linhas vermelhas indicam dependências que fazem parte de um ciclo</span>
            <span class="legend-item"><span class="legend-swatch"></span> Linhas cinzas são dependências normais, fora de qualquer ciclo</span>
        </div>
        {% endif %}

        <!--
            Print/PDF-only: a separate, server-rendered Graphviz diagram
            scoped to just the packages involved in a cycle or violation
            (build_pdf_diagram_svg, scripts/generate-report.py). Mermaid
            above is hidden in print (see @media print) - this is what
            actually appears on the page, since it's small and legible
            regardless of how large the full project graph is. Falls back to
            explanatory text when Graphviz (the Python package or the 'dot'
            binary) isn't available, or when there's simply nothing
            problematic to show.
        -->
        <div class="pdf-diagram-only">
            {% if pdf_diagram_svg %}
            <h3>Diagrama para impressão (apenas pacotes com ciclo ou violação)</h3>
            <div class="pdf-diagram-svg">{{ pdf_diagram_svg | safe }}</div>
            <p class="pdf-diagram-legend">
                Este diagrama mostra apenas os pacotes envolvidos em ciclos ou violações de
                camada — uma versão focada e legível para impressão. O diagrama completo e
                interativo está disponível no report.html.
                {% if cycles %}Linhas vermelhas indicam dependências que fazem parte de um ciclo.{% endif %}
            </p>
            {% else %}
            <p class="pdf-diagram-fallback">
                {% if metrics_summary.cycle_count or metrics_summary.violation_count %}
                O diagrama focado em pacotes problemáticos não pôde ser gerado nesta máquina
                (Graphviz não está disponível) — consulte as seções de Violações e Ciclos acima
                para o detalhamento completo, ou abra o report.html para o diagrama interativo
                completo.
                {% else %}
                Nenhum ciclo ou violação de camada foi detectado — sem pacotes problemáticos
                para destacar aqui. O diagrama completo está disponível no report.html.
                {% endif %}
            </p>
            {% endif %}
        </div>
    </section>

    <footer>
        <p class="footer-brand">Gerado por ArqSync v1.2.0</p>
        <p class="footer-note">
            A detecção de ciclos independe de convenção de nomenclatura; a detecção de violações
            de camada e de estilo arquitetural depende dos pacotes seguirem convenções de
            nomenclatura reconhecidas (ex.: <code>controller</code>/<code>service</code>/<code>repository</code>/<code>domain</code>) —
            trate como um indício, não uma verdade absoluta.
        </p>
    </footer>
</main>
<script>
    mermaid.initialize({ startOnLoad: true, theme: "neutral" });

    // "Gerar PDF" - delegates to the browser's own print pipeline. Every
    // major browser's print dialog offers "Save as PDF" (or prints straight
    // to a real printer) without any extra code here; the @media print rules
    // above are what make that output look right.
    (function () {
        var pdfButton = document.getElementById('generate-pdf-btn');
        if (pdfButton) {
            pdfButton.addEventListener('click', function () {
                window.print();
            });
        }
    })();

    // Diagram zoom/pan (transform: scale() + native scroll) and the
    // fullscreen "expand" toggle. Vanilla JS, no external library.
    //
    // Deliberately a single diagram instance, never duplicated into a
    // separate (initially hidden) modal: Mermaid renders once, on page
    // load, into whatever is in the DOM at that moment via
    // `startOnLoad: true` above. An element that's display:none at that
    // moment (e.g. a modal meant to be shown later) gets a broken/zero-size
    // SVG - Mermaid computes layout against the container's live box, and a
    // hidden container has none. "Expand" here just adds .is-fullscreen to
    // this same wrapper (position: fixed, CSS only), so the already-correctly
    // -rendered SVG is simply repositioned, never re-rendered.
    (function () {
        var wrapper = document.getElementById('diagram-wrapper');
        if (!wrapper) return;

        var toolbar = wrapper.querySelector('[data-diagram-toolbar]');
        var target = wrapper.querySelector('[data-zoom-target]');
        var backdrop = document.querySelector('[data-diagram-backdrop]');
        var expandButtons = document.querySelectorAll('[data-toggle-diagram]');
        var toolbarExpandBtn = wrapper.querySelector('.diagram-btn-expand');

        // Step/bounds in quarters (25%) so values land on round percentages
        // starting from the 75% default - legible out of the box even with
        // long, wrapped package names, with headroom up to 400% to zoom into
        // detail and down to 25% to fit very large diagrams on screen.
        var ZOOM_STEP = 0.25;
        var ZOOM_MIN = 0.25;
        var ZOOM_MAX = 4;

        if (toolbar && target) {
            var initial = parseFloat(toolbar.getAttribute('data-initial-zoom')) || 1;
            var zoom = initial;
            var label = toolbar.querySelector('[data-zoom-label]');

            var applyZoom = function () {
                target.style.transform = 'scale(' + zoom + ')';
                if (label) label.textContent = Math.round(zoom * 100) + '%';
            };

            toolbar.querySelectorAll('[data-action]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var action = btn.getAttribute('data-action');
                    if (action === 'zoom-in') zoom = Math.min(zoom + ZOOM_STEP, ZOOM_MAX);
                    else if (action === 'zoom-out') zoom = Math.max(zoom - ZOOM_STEP, ZOOM_MIN);
                    else if (action === 'zoom-reset') zoom = initial;
                    applyZoom();
                });
            });

            applyZoom();
        }

        // Neutralize the on-screen zoom for printing/PDF: the interactive
        // zoom controls set an inline transform on `target`, which (being
        // inline) would otherwise override even the @media print rule above
        // for scale/transform-origin. Reset to scale(1) right before print
        // and put the user's on-screen zoom back right after, so print never
        // inherits whatever zoom level the page happened to be at - the
        // print CSS's own scale(0.75) is the only thing that applies.
        // beforeprint/afterprint (not the "Gerar PDF" click handler) so this
        // also covers Ctrl+P and the browser's own print menu, not just our
        // button.
        if (target) {
            window.addEventListener('beforeprint', function () {
                target.dataset.zoomBeforePrint = target.style.transform;
                target.style.transform = 'scale(1)';
            });
            window.addEventListener('afterprint', function () {
                if (target.dataset.zoomBeforePrint !== undefined) {
                    target.style.transform = target.dataset.zoomBeforePrint;
                    delete target.dataset.zoomBeforePrint;
                }
            });
        }

        // "Exportar PNG" - rasterizes the already-rendered Mermaid SVG via a
        // plain <canvas> (no html2canvas/extra library): serialize the SVG,
        // draw it into an offscreen canvas at 2x its intrinsic size for a
        // crisp export, then trigger a normal file download. Uses the SVG's
        // own viewBox for sizing so the export is full resolution regardless
        // of the on-screen zoom level at the time of the click.
        var exportButton = toolbar && toolbar.querySelector('[data-export-png]');
        if (exportButton && target) {
            exportButton.addEventListener('click', function () {
                var svg = target.querySelector('svg');
                if (!svg) {
                    window.alert('O diagrama ainda não terminou de renderizar - tente novamente em instantes.');
                    return;
                }

                var clone = svg.cloneNode(true);
                if (!clone.getAttribute('xmlns')) {
                    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
                }

                var viewBox = svg.viewBox && svg.viewBox.baseVal;
                var width = (viewBox && viewBox.width) || parseFloat(svg.getAttribute('width')) || svg.clientWidth || 800;
                var height = (viewBox && viewBox.height) || parseFloat(svg.getAttribute('height')) || svg.clientHeight || 600;
                var exportScale = 2;

                var svgData = new XMLSerializer().serializeToString(clone);
                var svgBlob = new Blob([svgData], { type: 'image/svg+xml;charset=utf-8' });
                var svgUrl = URL.createObjectURL(svgBlob);

                var img = new Image();
                img.onload = function () {
                    var canvas = document.createElement('canvas');
                    canvas.width = width * exportScale;
                    canvas.height = height * exportScale;
                    var ctx = canvas.getContext('2d');
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    URL.revokeObjectURL(svgUrl);

                    canvas.toBlob(function (pngBlob) {
                        if (!pngBlob) {
                            window.alert('Não foi possível exportar o diagrama como PNG neste navegador.');
                            return;
                        }
                        var link = document.createElement('a');
                        link.download = 'arqsync-diagrama.png';
                        link.href = URL.createObjectURL(pngBlob);
                        link.click();
                        URL.revokeObjectURL(link.href);
                    });
                };
                img.onerror = function () {
                    URL.revokeObjectURL(svgUrl);
                    window.alert('Não foi possível exportar o diagrama como PNG neste navegador.');
                };
                img.src = svgUrl;
            });
        }

        function setFullscreen(on) {
            wrapper.classList.toggle('is-fullscreen', on);
            if (backdrop) backdrop.classList.toggle('is-visible', on);
            document.body.style.overflow = on ? 'hidden' : '';
            if (toolbarExpandBtn) toolbarExpandBtn.textContent = on ? '✕ Fechar' : '⤢ Expandir diagrama';
        }

        expandButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                setFullscreen(!wrapper.classList.contains('is-fullscreen'));
            });
        });
        if (backdrop) {
            backdrop.addEventListener('click', function () { setFullscreen(false); });
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && wrapper.classList.contains('is-fullscreen')) {
                setFullscreen(false);
            }
        });
    })();
</script>
</body>
</html>
