<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ArqSync — {{ project_name }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            color-scheme: light;
            --font-sans: "Inter", "Segoe UI", -apple-system, Roboto, Helvetica, Arial, sans-serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

            --bg: #f7f8fa;
            --surface: #ffffff;
            --surface-alt: #f3f4f7;
            --text: #1a1d23;
            --text-muted: #5c6472;
            --border: #e2e5ea;

            --accent: #2f5fef;
            --accent-bg: #eef2ff;
            --accent-dark: #1e3fb8;

            /* category colors: violation (danger), cycle (warning), normal (success) */
            --danger: #d1293d;
            --danger-bg: #fdecee;
            --danger-border: #f6c4cb;

            --warn: #b7791f;
            --warn-bg: #fdf3df;
            --warn-border: #f0d795;

            --success: #1a8a5f;
            --success-bg: #e8f7f0;
            --success-border: #b7e6cf;

            --radius: 10px;
            --shadow: 0 1px 2px rgba(20, 24, 33, 0.04), 0 6px 20px rgba(20, 24, 33, 0.05);
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 2.5rem 1.5rem 4rem;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 15.5px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        main { max-width: 980px; margin: 0 auto; }

        header.hero {
            margin-bottom: 1.5rem;
        }
        .eyebrow {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            background: var(--accent-bg);
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            margin-bottom: 0.6rem;
        }
        h1 {
            margin: 0 0 0.35rem;
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -0.01em;
        }
        h1 .project-name { color: var(--accent); }
        .subtitle { color: var(--text-muted); font-size: 0.92rem; margin: 0; }
        .subtitle code {
            background: var(--surface-alt);
            border: 1px solid var(--border);
            padding: 0.1rem 0.4rem;
            border-radius: 5px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
        }

        section { margin-bottom: 2rem; }
        h2 {
            font-size: 1.05rem;
            font-weight: 700;
            margin: 0 0 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .count-pill {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-muted);
            background: var(--surface-alt);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 0.05rem 0.55rem;
        }
        .section-intro { color: var(--text-muted); font-size: 0.92rem; margin: -0.4rem 0 1rem; }
        .empty-state {
            color: var(--success);
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            border-radius: var(--radius);
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* Architecture style card */
        .style-card {
            background: linear-gradient(135deg, var(--accent-bg), var(--surface));
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.4rem 1.6rem;
            box-shadow: var(--shadow);
        }
        .style-card h2 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }
        .style-card p {
            margin: 0;
            color: var(--text-muted);
            max-width: 68ch;
        }

        /* Diagram */
        .diagram-wrapper {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.1rem;
            overflow-x: auto;
            box-shadow: var(--shadow);
        }

        /* Cards (cycles / violations) */
        .card-list { display: flex; flex-direction: column; gap: 0.85rem; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-left-width: 4px;
            border-radius: var(--radius);
            padding: 1rem 1.15rem;
            box-shadow: var(--shadow);
        }
        .card.cycle { border-left-color: var(--warn); }
        .card.violation { border-left-color: var(--danger); }

        .card-path {
            font-family: var(--font-mono);
            font-size: 0.88rem;
            color: var(--text);
            margin: 0.3rem 0 0.7rem;
            word-break: break-word;
        }
        .badge {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
        }
        .badge.cycle { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-border); }
        .badge.violation-skip { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }
        .badge.violation-inversion { background: #f1e9fd; color: #7233c7; border: 1px solid #ddc4f7; }

        .card-explanation { margin: 0 0 0.6rem; color: var(--text); font-size: 0.92rem; }
        .card-suggestion {
            display: flex;
            gap: 0.55rem;
            align-items: flex-start;
            background: var(--surface-alt);
            border: 1px dashed var(--border);
            border-radius: 8px;
            padding: 0.6rem 0.75rem;
            font-size: 0.88rem;
            color: var(--text-muted);
        }
        .card-suggestion .suggestion-icon { flex: none; line-height: 1.3; }
        .card-suggestion strong { color: var(--text); font-weight: 600; }

        table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        thead th {
            text-align: left;
            padding: 0.55rem 0.8rem;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            border-bottom: 1px solid var(--border);
        }
        tbody td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover { background: var(--surface-alt); }
        table code { font-family: var(--font-mono); font-size: 0.85rem; }
        .table-wrapper {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .metrics-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.85rem;
            margin-bottom: 1.3rem;
        }
        .metric-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 0.95rem 1.1rem;
            box-shadow: var(--shadow);
        }
        .metric-tile .value { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
        .metric-tile .label { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.3rem; font-weight: 500; }
        .metric-tile.tone-neutral .value { color: var(--text); }
        .metric-tile.tone-good { background: var(--success-bg); border-color: var(--success-border); }
        .metric-tile.tone-good .value { color: var(--success); }
        .metric-tile.tone-warn { background: var(--warn-bg); border-color: var(--warn-border); }
        .metric-tile.tone-warn .value { color: var(--warn); }
        .metric-tile.tone-danger { background: var(--danger-bg); border-color: var(--danger-border); }
        .metric-tile.tone-danger .value { color: var(--danger); }

        footer {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 3rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
        }
        footer code { font-family: var(--font-mono); }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
</head>
<body>
<main>
    <header class="hero">
        <span class="eyebrow">Relatório de Arquitetura</span>
        <h1>ArqSync — <span class="project-name">{{ project_name }}</span></h1>
        <p class="subtitle">
            <code>{{ root_path }}</code><br>
            Gerado em {{ generated_at }}
        </p>
    </header>

    <section id="architecture-style" class="style-card">
        <h2>Arquitetura detectada: {{ architecture_style.name }}</h2>
        <p>{{ architecture_style.description }}</p>
    </section>

    <section id="metrics">
        <h2>Métricas</h2>
        <div class="metrics-summary">
            <div class="metric-tile tone-neutral">
                <div class="value">{{ metrics.totalPackages }}</div>
                <div class="label">Pacotes</div>
            </div>
            <div class="metric-tile tone-neutral">
                <div class="value">{{ metrics.totalClasses }}</div>
                <div class="label">Classes</div>
            </div>
            <div class="metric-tile {{ 'tone-warn' if metrics.cycleCount else 'tone-good' }}">
                <div class="value">{{ metrics.cycleCount }}</div>
                <div class="label">Ciclos</div>
            </div>
            <div class="metric-tile {{ 'tone-danger' if metrics.violationCount else 'tone-good' }}">
                <div class="value">{{ metrics.violationCount }}</div>
                <div class="label">Violações</div>
            </div>
        </div>

        {% if dependency_counts %}
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Pacote</th>
                        <th>Dependências recebidas</th>
                        <th>Dependências enviadas</th>
                    </tr>
                </thead>
                <tbody>
                    {% for count in dependency_counts %}
                    <tr>
                        <td><code>{{ count.package }}</code></td>
                        <td>{{ count.incoming }}</td>
                        <td>{{ count.outgoing }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="empty-state">Nenhum pacote com dependências para listar.</p>
        {% endif %}
    </section>

    <section id="diagram">
        <h2>Diagrama de dependências</h2>
        <p class="section-intro">
            Este diagrama mostra as dependências entre pacotes do projeto. Ciclos e violações de
            camada (detalhados abaixo) são as observações mais relevantes a procurar aqui.
        </p>
        <div class="diagram-wrapper">
            <pre class="mermaid">{{ mermaid_diagram }}</pre>
        </div>
    </section>

    <section id="cycles">
        <h2>Ciclos de dependência <span class="count-pill">{{ cycles | length }}</span></h2>
        {% if cycles %}
        <p class="section-intro">
            Um ciclo de dependência significa que dois ou mais pacotes dependem uns dos outros,
            direta ou indiretamente — isso dificulta entender, testar e evoluir esses pacotes de
            forma isolada.
        </p>
        <div class="card-list">
            {% for cycle in cycles %}
            <div class="card cycle">
                <span class="badge cycle">Ciclo de {{ cycle.length }} pacote{{ 's' if cycle.length != 1 else '' }}</span>
                <div class="card-path">{{ cycle.path }}</div>
                <p class="card-explanation">{{ cycle.explanation }}</p>
                <div class="card-suggestion">
                    <span class="suggestion-icon">💡</span>
                    <span><strong>Sugestão:</strong> {{ cycle.suggestion }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">✓ Nenhum ciclo de dependência detectado.</p>
        {% endif %}
    </section>

    <section id="violations">
        <h2>Violações de camada <span class="count-pill">{{ violations | length }}</span></h2>
        {% if violations %}
        <div class="card-list">
            {% for violation in violations %}
            <div class="card violation">
                <span class="badge {{ 'violation-skip' if violation.type == 'LAYER_SKIP' else 'violation-inversion' }}">
                    {{ 'Camada pulada' if violation.type == 'LAYER_SKIP' else 'Inversão de camada' }}
                </span>
                <div class="card-path">{{ violation.from }} ({{ violation.from_layer | lower }}) → {{ violation.to }} ({{ violation.to_layer | lower }})</div>
                <p class="card-explanation">{{ violation.explanation }}</p>
                <div class="card-suggestion">
                    <span class="suggestion-icon">💡</span>
                    <span><strong>Sugestão:</strong> {{ violation.suggestion }}</span>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">✓ Nenhuma violação de camada detectada.</p>
        {% endif %}
    </section>

    <footer>
        Gerado pelo ArqSync. A detecção de ciclos independe de convenção de nomenclatura; a
        detecção de violações de camada e de estilo arquitetural depende dos pacotes seguirem
        convenções de nomenclatura reconhecidas (ex.: <code>controller</code>/<code>service</code>/<code>repository</code>/<code>domain</code>) —
        trate como um indício, não uma verdade absoluta.
    </footer>
</main>
<script>
    mermaid.initialize({ startOnLoad: true, theme: "neutral" });
</script>
</body>
</html>
