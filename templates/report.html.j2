<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>ArqSync — {{ project_name }}</title>
    <style>
        :root {
            color-scheme: light;
            --bg: #ffffff;
            --bg-alt: #f5f6f8;
            --text: #1f2328;
            --text-muted: #57606a;
            --border: #d0d7de;
            --accent: #0969da;
            --danger: #cf222e;
            --danger-bg: #fff1f0;
            --warn: #9a6700;
            --warn-bg: #fff8e6;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 2rem;
            background: var(--bg);
            color: var(--text);
            font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5;
        }
        main { max-width: 960px; margin: 0 auto; }
        header { margin-bottom: 2rem; }
        h1 { margin: 0 0 0.25rem; font-size: 1.6rem; }
        .subtitle { color: var(--text-muted); font-size: 0.95rem; }
        .subtitle code { background: var(--bg-alt); padding: 0.1rem 0.35rem; border-radius: 4px; }
        section { margin-bottom: 2.5rem; }
        h2 { font-size: 1.2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
        .empty-state { color: var(--text-muted); font-style: italic; }
        .diagram-wrapper {
            background: var(--bg-alt);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem;
            overflow-x: auto;
        }
        .card-list { display: flex; flex-direction: column; gap: 0.75rem; }
        .card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.9rem 1rem;
        }
        .card.cycle { background: var(--warn-bg); border-color: #eac54f; }
        .card.violation { background: var(--danger-bg); border-color: #f2a5a5; }
        .card-path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.92rem; }
        .badge {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.1rem 0.5rem;
            border-radius: 999px;
            margin-bottom: 0.35rem;
        }
        .badge.cycle { background: var(--warn); color: white; }
        .badge.violation-skip { background: var(--danger); color: white; }
        .badge.violation-inversion { background: #8250df; color: white; }
        .card-explanation { margin: 0.4rem 0 0; color: var(--text); }
        table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
        th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
        th { color: var(--text-muted); font-weight: 600; }
        .metrics-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .metric-tile {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            text-align: center;
        }
        .metric-tile .value { font-size: 1.5rem; font-weight: 700; }
        .metric-tile .label { font-size: 0.8rem; color: var(--text-muted); }
        footer { color: var(--text-muted); font-size: 0.8rem; margin-top: 3rem; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
</head>
<body>
<main>
    <header>
        <h1>ArqSync — {{ project_name }}</h1>
        <p class="subtitle">
            <code>{{ root_path }}</code><br>
            Gerado em {{ generated_at }}
        </p>
    </header>

    <section id="diagram">
        <h2>Diagrama de dependências</h2>
        <p>
            Este diagrama mostra as dependências entre pacotes do projeto. Ciclos e violações de
            camada (detalhados abaixo) são as observações mais relevantes a procurar aqui.
        </p>
        <div class="diagram-wrapper">
            <pre class="mermaid">{{ mermaid_diagram }}</pre>
        </div>
    </section>

    <section id="cycles">
        <h2>Ciclos de dependência ({{ cycles | length }})</h2>
        {% if cycles %}
        <p>
            Um ciclo de dependência significa que dois ou mais pacotes dependem uns dos outros,
            direta ou indiretamente — isso dificulta entender, testar e evoluir esses pacotes de
            forma isolada.
        </p>
        <div class="card-list">
            {% for cycle in cycles %}
            <div class="card cycle">
                <span class="badge cycle">Ciclo de {{ cycle.length }} pacote{{ 's' if cycle.length != 1 else '' }}</span>
                <div class="card-path">{{ cycle.path }}</div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhum ciclo de dependência detectado.</p>
        {% endif %}
    </section>

    <section id="violations">
        <h2>Violações de camada ({{ violations | length }})</h2>
        {% if violations %}
        <div class="card-list">
            {% for violation in violations %}
            <div class="card violation">
                <span class="badge {{ 'violation-skip' if violation.type == 'LAYER_SKIP' else 'violation-inversion' }}">
                    {{ 'Camada pulada' if violation.type == 'LAYER_SKIP' else 'Inversão de camada' }}
                </span>
                <div class="card-path">{{ violation.from }} ({{ violation.from_layer | lower }}) → {{ violation.to }} ({{ violation.to_layer | lower }})</div>
                <p class="card-explanation">{{ violation.explanation }}</p>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">Nenhuma violação de camada detectada.</p>
        {% endif %}
    </section>

    <section id="metrics">
        <h2>Métricas</h2>
        <div class="metrics-summary">
            <div class="metric-tile">
                <div class="value">{{ metrics.totalPackages }}</div>
                <div class="label">Pacotes</div>
            </div>
            <div class="metric-tile">
                <div class="value">{{ metrics.totalClasses }}</div>
                <div class="label">Classes</div>
            </div>
            <div class="metric-tile">
                <div class="value">{{ metrics.cycleCount }}</div>
                <div class="label">Ciclos</div>
            </div>
            <div class="metric-tile">
                <div class="value">{{ metrics.violationCount }}</div>
                <div class="label">Violações</div>
            </div>
        </div>

        {% if dependency_counts %}
        <table>
            <thead>
                <tr>
                    <th>Pacote</th>
                    <th>Dependências recebidas</th>
                    <th>Dependências enviadas</th>
                </tr>
            </thead>
            <tbody>
                {% for count in dependency_counts %}
                <tr>
                    <td><code>{{ count.package }}</code></td>
                    <td>{{ count.incoming }}</td>
                    <td>{{ count.outgoing }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">Nenhum pacote com dependências para listar.</p>
        {% endif %}
    </section>

    <footer>
        Gerado pelo ArqSync. A detecção de ciclos independe de convenção de nomenclatura; a
        detecção de violações de camada depende dos pacotes seguirem a convenção
        <code>controller</code>/<code>service</code>/<code>repository</code>/<code>domain</code> —
        trate como um indício, não uma verdade absoluta.
    </footer>
</main>
<script>
    mermaid.initialize({ startOnLoad: true, theme: "neutral" });
</script>
</body>
</html>
